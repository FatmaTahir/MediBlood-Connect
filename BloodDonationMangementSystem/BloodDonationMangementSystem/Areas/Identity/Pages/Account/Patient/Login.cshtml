@page
@model BloodDonationManagementSystem.Areas.Identity.Pages.Account.Patient.PatientLoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Patient Login - MediBlood Connect</title>

    <!-- Bootstrap CSS -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    <style>
        :root {
            --bg-dark: #121418;
            --surface-dark: #1e222d;
            --input-bg: #151821;
            --border-color: #2b303c;
            --accent-red: #ea384d;
            --accent-red-hover: #d32f42;
            --text-main: #ffffff;
            --text-muted: #8e95a5;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
        }

        .login-card {
            background-color: var(--surface-dark);
            border: 1px solid var(--border-color);
            border-radius: 12px;
        }

        .brand-icon-box {
            width: 38px;
            height: 38px;
            background: rgba(234, 56, 77, 0.15);
            border: 1px solid rgba(234, 56, 77, 0.25);
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .form-label {
            font-size: 0.75rem;
            font-weight: 500;
            color: #b0b7c3;
            margin-bottom: 0.15rem;
        }

        .form-control {
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            font-size: 0.8125rem;
            padding: 0.4rem 0.65rem;
            border-radius: 6px;
        }

            .form-control:focus {
                background-color: var(--input-bg);
                border-color: var(--accent-red);
                color: var(--text-main);
                box-shadow: 0 0 0 0.2rem rgba(234, 56, 77, 0.2);
            }

            .form-control::placeholder {
                color: #525a6b;
            }

        .btn-theme {
            background-color: var(--accent-red);
            border: none;
            color: #ffffff;
            font-weight: 600;
            font-size: 0.875rem;
            border-radius: 6px;
            padding: 0.45rem;
            transition: all 0.2s ease-in-out;
        }

            .btn-theme:hover {
                background-color: var(--accent-red-hover);
                color: #ffffff;
            }

        .text-red-accent {
            color: var(--accent-red) !important;
        }

        .field-validation-error {
            font-size: 0.7rem;
            line-height: 1;
            display: block;
            margin-top: 2px;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">

    <div class="container py-2">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-9 col-md-6 col-lg-4">

                <div class="card login-card shadow">
                    <div class="card-body p-3">

                        <!-- Header -->
                        <div class="text-center mb-3">
                            <div class="brand-icon-box mb-2">
                                <i class="bi bi-droplet-fill text-red-accent fs-5"></i>
                            </div>
                            <h5 class="fw-bold text-white mb-0">Patient Login</h5>
                            <p class="text-muted small mb-0" style="font-size: 0.75rem;">Access your MediBlood Connect account</p>
                        </div>

                        <!-- Form -->
                        <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>

                            <!-- Email Field -->
                            <div class="mb-2">
                                <label asp-for="Input.Email" class="form-label">Email address</label>
                                <input asp-for="Input.Email"
                                       class="form-control"
                                       autocomplete="username"
                                       placeholder="name@example.com" />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>

                            <!-- Password Field -->
                            <div class="mb-3">
                                <label asp-for="Input.Password" class="form-label">Password</label>
                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       placeholder="Password" />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>

                            <!-- Submit Button -->
                            <button id="login-submit"
                                    type="submit"
                                    class="btn btn-theme w-100">
                                Log In
                            </button>

                            <!-- Navigation Link -->
                            <div class="text-center mt-2">
                                <span class="text-muted" style="font-size: 0.75rem;">Don't have an account?</span>
                                <a asp-area="Identity"
                                   asp-page="/Account/Patient/Register"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="text-red-accent fw-semibold text-decoration-none ms-1"
                                   style="font-size: 0.75rem;">
                                    Register
                                </a>
                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Client-side scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

</body>
</html>