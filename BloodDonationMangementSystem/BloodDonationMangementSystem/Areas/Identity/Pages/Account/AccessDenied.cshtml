@page
@model BloodDonationMangementSystem.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - MediBlood Connect</title>

    <!-- Bootstrap CSS -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    <style>
        :root {
            --bg-dark: #121418;
            --surface-dark: #1e222d;
            --border-color: #2b303c;
            --accent-red: #ea384d;
            --accent-red-hover: #d32f42;
            --text-main: #ffffff;
            --text-muted: #8e95a5;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
        }

        .access-card {
            background-color: var(--surface-dark);
            border: 1px solid var(--border-color);
            border-radius: 12px;
        }

        .brand-icon-box {
            width: 48px;
            height: 48px;
            background: rgba(234, 56, 77, 0.15);
            border: 1px solid rgba(234, 56, 77, 0.25);
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-theme {
            background-color: var(--accent-red);
            border: none;
            color: #ffffff;
            font-weight: 600;
            font-size: 0.875rem;
            border-radius: 6px;
            padding: 0.45rem 1rem;
            transition: all 0.2s ease-in-out;
            text-decoration: none;
            display: inline-block;
        }

            .btn-theme:hover {
                background-color: var(--accent-red-hover);
                color: #ffffff;
            }

        .text-red-accent {
            color: var(--accent-red) !important;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">

    <div class="container py-2">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-9 col-md-6 col-lg-4">

                <div class="card access-card shadow text-center">
                    <div class="card-body p-4">

                        <!-- Icon -->
                        <div class="brand-icon-box mb-3">
                            <i class="bi bi-shield-lock-fill text-red-accent fs-4"></i>
                        </div>

                        <!-- Header -->
                        <h4 class="fw-bold text-white mb-2">Access Denied</h4>

                        <!-- Message -->
                        <p class="text-muted small mb-4" style="font-size: 0.8125rem;">
                            You do not have permission to access this page or resource.
                        </p>

                        <!-- Action Button -->
                        <a asp-page="/Index" class="btn btn-theme w-100">
                            Go Home
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Client-side scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>