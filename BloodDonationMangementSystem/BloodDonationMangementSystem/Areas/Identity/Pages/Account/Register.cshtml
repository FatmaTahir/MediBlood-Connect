@page
@model RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Donor Registration - MediBlood Connect</title>

    <!-- Bootstrap CSS & Icons -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    <style>
        :root {
            --bg-dark: #121418;
            --surface-dark: #1a1d24;
            --surface-hover: #222630;
            --border-color: #2a2f3d;
            --accent-red: #e63946;
            --text-main: #f8f9fa;
            --text-muted: #8e95a5;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        .register-card {
            background-color: var(--surface-dark);
            border: 1px solid var(--border-color);
            border-radius: 16px;
        }

        /* Standard Controls Dark Theme */
        .form-control, .form-select {
            background-color: var(--bg-dark);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            font-size: 0.875rem;
            padding: 0.5rem 0.75rem;
        }

            .form-control:focus, .form-select:focus {
                background-color: var(--bg-dark);
                border-color: var(--accent-red);
                color: var(--text-main);
                box-shadow: 0 0 0 0.25rem rgba(230, 57, 70, 0.25);
            }

            .form-control::placeholder {
                color: #5a6275;
            }

        .form-label {
            color: var(--text-muted);
            font-size: 0.8125rem;
            font-weight: 500;
            margin-bottom: 0.25rem;
        }

        .brand-icon-box {
            width: 44px;
            height: 44px;
            background: rgba(230, 57, 70, 0.15);
            border: 1px solid rgba(230, 57, 70, 0.3);
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-danger-custom {
            background-color: var(--accent-red);
            border: none;
            color: #ffffff;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
        }

            .btn-danger-custom:hover {
                background-color: #d62839;
                color: #ffffff;
            }
    </style>
</head>
<body>

    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
        <div class="col-md-8 col-lg-6">

            <div class="card register-card shadow-lg p-2">
                <div class="card-body p-4">

                    <!-- Header with Icon -->
                    <div class="text-center mb-4">
                        <div class="brand-icon-box mb-3">
                            <i class="bi bi-person-plus-fill text-danger fs-5"></i>
                        </div>
                        <h4 class="fw-bold text-light mb-1">Register as Donor</h4>
                        <p class="text-secondary small mb-0">Create your MediBlood Connect account</p>
                    </div>

                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3 p-2 rounded bg-danger bg-opacity-10 border border-danger border-opacity-25"
                             role="alert"></div>

                        <!-- Full Name & Age -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FullName" class="form-label">Full Name</label>
                                <input asp-for="Input.FullName"
                                       class="form-control"
                                       placeholder="Enter full name" />
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.Age" class="form-label">Age</label>
                                <input asp-for="Input.Age"
                                       class="form-control"
                                       placeholder="Enter age" min="18" max="65" />
                                <span asp-validation-for="Input.Age" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- CNIC & Contact -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.CNIC" class="form-label">CNIC (13 Digits)</label>
                                <input asp-for="Input.CNIC"
                                       class="form-control"
                                       placeholder="3420112345671"
                                       pattern="\d{13}"
                                       title="CNIC must be exactly 13 digits without dashes" />
                                <span asp-validation-for="Input.CNIC" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.Contact" class="form-label">Contact Number</label>
                                <input asp-for="Input.Contact"
                                       class="form-control"
                                       placeholder="03XXXXXXXXX"
                                       pattern="03\d{9}"
                                       title="Phone number must start with 03 and contain 11 digits" />
                                <span asp-validation-for="Input.Contact" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Blood Group & Availability -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.BloodGroup" class="form-label">Blood Group</label>
                                <select asp-for="Input.BloodGroup" class="form-select">
                                    <option value="" disabled selected>Select blood group</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                </select>
                                <span asp-validation-for="Input.BloodGroup" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.Availability" class="form-label">Available for Donation</label>
                                <select asp-for="Input.Availability" class="form-select">
                                    <option value="" disabled selected>Select availability</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                                <span asp-validation-for="Input.Availability" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email Address</label>
                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <!-- Password & Confirm Password -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Input.Password" class="form-label">Password</label>
                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Enter password" />
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Confirm password" />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button id="registerSubmit"
                                type="submit"
                                class="btn btn-danger-custom w-100 py-2 d-flex align-items-center justify-content-center gap-2 mb-3">
                            <i class="bi bi-person-check-fill"></i> Register
                        </button>

                        <!-- Navigation Link -->
                        <div class="text-center small">
                            <span class="text-secondary">Already have an account?</span>
                            <a asp-page="./Login"
                               asp-route-returnUrl="@Model.ReturnUrl"
                               class="text-danger fw-semibold text-decoration-none ms-1">
                                Log in
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>