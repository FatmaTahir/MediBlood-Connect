@model List<BloodDonationManagementSystem.Models.BloodRequest>
@{
    Layout = null;
}
<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body class="m-0 p-0 bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-outline-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        You have not submitted any donation request yet!
    </div>
}
else
{      

       <div class="m-0 p-0 bg-light">

        <div class="d-flex m-0 p-0">

            <div class="flex-grow-1 p-4">

                <h2 class="fw-bold mb-3">My Requests</h2>
                <p class="text-secondary mb-4">Below are  the blood requests you have submitted.</p>

                <table class="table table-bordered table-striped mt-3">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Patient Name</th>
                            <th>Blood Group</th>
                            <th>Units Required</th>
                            <th>Reason</th>
                            <th>Urgency Level</th>
                            <th>Status</th>

                        </tr>
                    </thead>


                    <tbody>
                        @if (Model != null || Model.Any())
                        {
                            int count = 1;
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td>@count</td>
                                    <td>@v.PatientName</td>
                                    <td>@v.BloodGroup</td>
                                    <td>@v.UnitsRequired</td>
                                    <td>@v.Reason</td>
                                    <td>@v.Urgency</td>
                                    <td>
                                        @if (v.Status == "Pending")
                                        {
                                            <span class="fw-bold badge bg-warning text-dark">@v.Status</span>
                                        }
                                        else if (v.Status == "Approved")
                                        {
                                            <span class="fw-bold badge bg-success text-white">@v.Status</span>
                                        }
                                        else if (v.Status == "Rejected")
                                        {
                                            <span class="fw-bold badge bg-danger text-white">@v.Status</span>
                                        }
                                    </td>
                                </tr>
                                count++;
                            }
                        }

                    </tbody>



                </table>

            </div>

        </div>

    </div>
    }
    </body>
    </html>


