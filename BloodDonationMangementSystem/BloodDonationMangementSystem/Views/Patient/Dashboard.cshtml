@{
    Layout = null;
}

<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body class="m-0 p-0 bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-outline-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
    <div class="d-flex m-0 p-0">

        <div class="flex-grow-1 p-4">
            <h2 class="fw-bold"> Dashboard</h2>
            <p class="text-secondary">From here you can request blood, check request status, and see matching donors.</p>

            <div class="row mt-4">
                <div class="col-md-4 mb-4">
                    <div class="card text-white  shadow-lg rounded-3" style="background: linear-gradient(135deg, #b11226, #e63946);">
                        <div class="card-body text-center py-4">
                            <h4 class="card-title fw-bold mb-3">Request Blood</h4>
                            <a asp-controller="Patient" asp-action="RequestBlood"  class="btn btn-light px-4">Click Here</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="card text-white  shadow-lg rounded-3" style="  background: linear-gradient(135deg, #7a0c1a, #b11226);
">
                        <div class="card-body text-center py-4">
                            <h4 class="card-title fw-bold mb-3">My Requests</h4>
                            <a asp-controller="Patient" asp-action="MyRequests" class="btn btn-light px-4">Click Here</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="card text-white  shadow-lg rounded-3" style=" background: linear-gradient(135deg, #343a40, #495057);
">
                        <div class="card-body text-center py-4">
                            <h4 class="card-title fw-bold mb-3">Matching Donors</h4>
                            <a asp-controller="Patient" asp-action="ViewMatchingDonors"  class="btn btn-light px-4">Click Here</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div> 

</body>
</html>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.7/signalr.min.js"></script>

<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationHub")
        .build();

    connection.on("ReceiveNotification", function (message) {
        alert(message);
    });

    connection.start()
        .catch(err => console.error(err.toString()));
</script>
