@model BloodDonationManagementSystem.Models.User
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Patient Dashboard - MediBloodConnect</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #0f1115;
            --card-dark: #181c23;
            --card-border: rgba(255, 255, 255, 0.08);
            --primary-red: #ef4444;
            --primary-red-hover: #dc2626;
            --text-muted: #94a3b8;
        }

        html, body {
            min-height: 100vh;
            margin: 0;
            background-color: var(--bg-dark);
            color: #f8f9fa;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        .page-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Top Navbar */
        .navbar-custom {
            background-color: #12151b;
            border-bottom: 1px solid var(--card-border);
            height: 64px;
            flex-shrink: 0;
        }

        .brand-logo {
            font-weight: 700;
            font-size: 1.2rem;
            letter-spacing: -0.5px;
            color: #fff;
            text-decoration: none;
        }

        /* Main Content Container */
        .main-content {
            flex: 1;
            padding: 3.5rem 1.5rem;
            max-width: 1140px;
            margin: 0 auto;
            width: 100%;
        }

        .portal-tag {
            color: var(--primary-red);
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .dashboard-desc {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Card Container (Donor Portal Style) */
        .action-container-card {
            background-color: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.5rem 1.75rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        /* Icon Wrapper Matching Donor Dashboard */
        .action-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .icon-red-box {
            background-color: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.25);
            color: #ef4444;
        }

        .icon-teal-box {
            background-color: rgba(6, 182, 212, 0.12);
            border: 1px solid rgba(6, 182, 212, 0.25);
            color: #06b6d4;
        }

        .icon-gray-box {
            background-color: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #94a3b8;
        }

        .action-title {
            font-weight: 600;
            font-size: 0.95rem;
            color: #ffffff;
            margin-bottom: 2px;
            line-height: 1.2;
        }

        .action-subtitle {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.2;
        }

        /* Buttons Styling Matched to Donor Portal */
        .btn-portal-primary {
            background-color: var(--primary-red);
            color: #ffffff !important;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.45rem 1rem;
            border-radius: 8px;
            border: none;
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

            .btn-portal-primary:hover {
                background-color: var(--primary-red-hover);
                color: #ffffff !important;
                box-shadow: 0 0 12px rgba(239, 68, 68, 0.4);
            }

        .btn-portal-secondary {
            background-color: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff !important;
            font-weight: 500;
            font-size: 0.85rem;
            padding: 0.45rem 1rem;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

            .btn-portal-secondary:hover {
                background-color: rgba(255, 255, 255, 0.08);
                border-color: rgba(255, 255, 255, 0.28);
                color: #ffffff !important;
            }

        .btn-chevron {
            font-size: 0.8rem;
            stroke-width: 1.5;
        }

        @@media (max-width: 991px) {
            .action-col {
                margin-bottom: 1.25rem;
            }

                .action-col:last-child {
                    margin-bottom: 0;
                }
        }
    </style>
</head>
<body>

    <div class="page-wrapper">
        <!-- Header / Navbar -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark navbar-custom px-3">
                <div class="container-fluid">
                    <a class="brand-logo d-flex align-items-center gap-2" asp-controller="Patient" asp-action="Dashboard">
                        <i class="bi bi-droplet-fill text-danger fs-5"></i>
                        <span>Medi<span class="text-danger">Blood</span>Connect</span>
                    </a>

                    <button class="navbar-toggler py-0 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarContent">
                        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-3 small">
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Patient" asp-action="Dashboard">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Patient" asp-action="MyRequests">My Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Patient" asp-action="RequestBlood">Request Blood</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Patient" asp-action="ViewMatchingDonors">Matching Donors</a>
                            </li>
                        </ul>

                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-danger btn-sm px-2 py-1 fs-7" asp-area="Identity"
                               asp-page="/Account/Patient/Login">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Main Dashboard Content -->
        <main class="main-content">
            <!-- Header Section -->
            <div class="text-center mb-5">
                <div class="d-flex align-items-center justify-content-center gap-2 text-danger fw-semibold small mb-1">
                    <i class="bi bi-heart-pulse-fill "></i> RECIPIENT PORTAL
                </div>
                <p class="dashboard-desc mb-0">Manage your blood requests, check request statuses, and discover matching donors nearby.</p>
            </div>

            <!-- Single Horizontal Action Card Container -->
            <div class="action-container-card">
                <div class="row g-4 align-items-center">

                    <!-- Action 1: Request Blood -->
                    <div class="col-lg-4 action-col">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="action-icon-wrapper icon-red-box">
                                    <i class="bi bi-droplet-fill"></i>
                                </div>
                                <div>
                                    <div class="action-title">Request Blood</div>
                                    <p class="action-subtitle">Start new request process</p>
                                </div>
                            </div>
                            <a asp-controller="Patient" asp-action="RequestBlood" class="btn-portal-primary ms-2">
                                Start <i class="bi bi-chevron-right btn-chevron"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Action 2: Request Status -->
                    <div class="col-lg-4 action-col">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="action-icon-wrapper icon-teal-box">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                                <div>
                                    <div class="action-title">Request Status</div>
                                    <p class="action-subtitle">Track pending & past requests</p>
                                </div>
                            </div>
                            <a asp-controller="Patient" asp-action="MyRequests" class="btn-portal-secondary ms-2">
                                View <i class="bi bi-chevron-right btn-chevron"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Action 3: Matching Donors -->
                    <div class="col-lg-4 action-col">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="action-icon-wrapper icon-gray-box">
                                    <i class="bi bi-people-fill"></i>
                                </div>
                                <div>
                                    <div class="action-title">Matching Donors</div>
                                    <p class="action-subtitle">Browse available donors</p>
                                </div>
                            </div>
                            <a asp-controller="Patient" asp-action="ViewMatchingDonors" class="btn-portal-secondary ms-2">
                                Find <i class="bi bi-chevron-right btn-chevron"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>

    <!-- SignalR Notification Script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.7/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("ReceiveNotification", function (message) {
            alert(message);
        });

        connection.start()
            .catch(err => console.error(err.toString()));
    </script>
</body>
</html>