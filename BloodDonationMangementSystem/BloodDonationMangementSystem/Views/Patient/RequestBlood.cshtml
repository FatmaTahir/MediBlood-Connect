@model BloodDonationManagementSystem.Models.Patient;
@{
    Layout = null;
}
<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body class="m-0 p-0 bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-outline-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
    <div class="d-flex m-0 p-0">
        <div class="flex-grow-1 p-4">

            <h1 class="mb-4 ms-5 fw-bold">Request Blood</h1>
            <p class="text-secondary  mb-4 ms-5 ">Fill the form below to submit a blood request.</p>

            <form asp-controller="Patient" asp-action="RequestBlood" method="post" class="w-100 mt-3 p-4 border border-light-subtle rounded" style="max-width: 900px; margin-left: 20px;">

                <div class="d-flex flex-row gap-3 mb-3">

                    <div class="w-100">
                        <select name="BloodGroup" class="form-select" required>
                            <option value="">Choose Blood Group</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                    </div>
                    <div class="w-100">
                        <input type="text" name="PatientName" class="form-control"
                               placeholder="Patient Name" required />
                    </div>
                    @* <div class="w-100">
                        <input type="email" name="PatientEmail" class="form-control"
                               placeholder="Patient Email" required />
                    </div> *@

                    <div class="w-100">
                        <input type="number" name="UnitsRequired" class="form-control"
                               placeholder="Units Required" min="1" max="5" required />
                    </div>

                    <div class="w-100">
                        <select name="Urgency" class="form-select" required>
                            <option value="">Urgency</option>
                            <option value="Normal">Normal</option>
                            <option value="Urgent">Urgent</option>
                            <option value="Critical">Critical</option>
                        </select>
                    </div>

                </div>
                <div class="mb-4">
                    <textarea name="Reason"  class="form-control"  placeholder="Reason for blood request..."  rows="3"  required></textarea>
                </div>

                <div class=" text-center me-5">
                    <button class="btn btn-danger" style="width:160px; height:35px;">Submit</button>
                </div>

            </form>
           
            </div>

        </div>

   

</body>
</html>

