@model List<BloodDonationManagementSystem.Models.User>
@{
    Layout = null;
}
<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body class="m-0 p-0 bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-outline-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
@if (ViewBag.ApprovalStatus == "NotApproved")
{
    <div class="alert alert-info">
        Your blood request is still pending approval.
        Matching donors will appear once it gets approved.
    </div>
}
else if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">
        Your request is approved, but no matching donors are available at the moment.
    </div>
}
else
{
    <div class="container">
    <h2 class="fw-bold mb-3 mt-5">Matching Donors</h2>

    <p class="text-muted mb-4">
        These donors match the blood group required in your approved request.
    </p>

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Donor Name</th>
                <th>Blood Group</th>
                <th>Contact</th>
                <th>Availability</th>
            </tr>
        </thead>
        <tbody>
            @{
                int count = 1;
            }
            @foreach (var d in Model)
            {
                <tr>
                    <td>@count</td>
                    <td>@d.FullName</td>
                    <td>@d.BloodGroup</td>
                    <td>@d.Contact</td>
                    <td>
                        @if (d.Availability)
                        {
                            <span class="badge bg-secondary">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Not Available</span>
                        }
                    </td>
                </tr>
                count++;

            }
        </tbody>
    </table>
        </div>
}
</body>
</html>