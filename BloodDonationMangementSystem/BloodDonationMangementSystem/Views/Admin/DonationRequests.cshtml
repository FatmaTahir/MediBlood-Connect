@model List<BloodDonationManagementSystem.Models.DonationRequest>
@{
    Layout = null;
}
<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body class="m-0 p-0 bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
    <div class="d-flex m-0 p-0">

       

        <div class="flex-grow-1 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-4 ms-5">Donation Requests</h2>
                <a asp-action="DonationRequests"  asp-controller="Admin"   class="btn btn-outline-secondary">Refresh</a>
            </div>

            <div class="card shadow-sm mb-4 p-3">
                <form asp-action="DonationRequests" asp-controller="Admin" method="get" id="filterForm">
                    <div class="row g-3">

                        <div class="col-md-3 ">
                            <label class="form-label fw-bold">Blood Group</label>
                            <select name="bloodGroup" class="form-select">
                                <option value="">All</option>
                                <option>A+</option>
                                <option>A-</option>
                                <option>B+</option>
                                <option>B-</option>
                                <option>O+</option>
                                <option>O-</option>
                                <option>AB+</option>
                                <option>AB-</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Status</label>
                            <select name="status" class="form-select">
                                <option value="">All</option>
                                <option>Pending</option>
                                <option>Approved</option>
                                <option>Rejected</option>
                                <option>Completed</option>
                            </select>
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-danger w-50">
                                Search
                            </button>
                        </div>

                    </div>
                </form>
            </div>


            <div class="card shadow-sm">
                <div class="card-body">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Blood Group</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody id="requestsTable">
                            @await Html.PartialAsync("_DonationRequestsTable", Model)
                        </tbody>
                       

                    </table>
                </div>
            </div>
           

        </div>

    </div>

</body>
</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$('#filterForm').on('submit', function (e) {
    e.preventDefault();

    var bloodGroup = $('select[name="bloodGroup"]').val() || null;
    var status = $('select[name="status"]').val() || null;

    $.ajax({
        url: '@Url.Action("DonationRequestsTable", "Admin")',
        type: 'get',
        data: { bloodGroup: bloodGroup, status: status },
        success: function (res) {
            $('#requestsTable').html(res);
        }
    });
});
</script>

