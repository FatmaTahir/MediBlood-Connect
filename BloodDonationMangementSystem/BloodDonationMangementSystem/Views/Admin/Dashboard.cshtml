@model BloodDonationManagementSystem.Models.AdminDashboardVM
@{
    Layout = null;
}
<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #f5f6f7;
            font-family: 'Segoe UI', sans-serif;
        }

        .dashboard-title {
            color: black;
        }

        .dashboard-subtitle {
            color: #6c757d;
        }

        .theme-card {
            border: none;
            border-radius: 12px;
            color: #fff;
        }

        .bg-blood {
            background: linear-gradient(135deg, #b11226, #e63946);
        }

        .bg-dark-red {
            background: linear-gradient(135deg, #7a0c1a, #b11226);
        }

        .bg-muted-dark {
            background: linear-gradient(135deg, #343a40, #495057);
        }

        .theme-btn-primary {
            background-color: #b11226;
            border: none;
        }

            .theme-btn-primary:hover {
                background-color: #8f0f1f;
            }

        .theme-btn-outline {
            border: 1px solid #b11226;
            color: #b11226;
        }

            .theme-btn-outline:hover {
                background-color: #b11226;
                color: #fff;
            }

        .low-stock-card {
            background-color: #fff3cd;
            border-left: 5px solid #b11226;
            border-radius: 8px;
        }
    </style>

</head>

<body class="m-0 p-0 " >
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
    <div class="d-flex m-0 p-0">

        <div class="flex-grow-1 p-4">
            <h2 class="fw-bold dashboard-title">Admin Dashboard</h2>
            <p class="dashboard-subtitle">
                From here you can manage donation requests, blood requests, and donors.
            </p>

            <div class="row mt-4">

                <div class="col-md-4 mb-4">
                    <div class="card shadow-lg rounded-3 text-white bg-blood">
                        <div class="card-body text-center py-4">
                            <h4 class="card-title fw-bold mb-3">Donation Requests</h4>
                            <h4 class="mt-3">@Model.TotalDonoationRequests</h4>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="card shadow-lg rounded-3 text-white bg-dark-red">
                        <div class="card-body text-center py-4">
                            <h4 class="card-title fw-bold mb-3">Blood Requests</h4>
                            <h4 class="mt-3">@Model.TotalBloodRequests</h4>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="card shadow-lg rounded-3 text-white bg-muted-dark">
                        <div class="card-body text-center py-4">
                            <h4 class="card-title fw-bold mb-3">Donations Completed</h4>
                            <h4 class="mt-3">44</h4>
                        </div>
                    </div>
                </div>

            </div>

            <div class="mb-4 ">
                <h5 class="fw-bold">Quick Actions</h5>
                <a class="btn theme-btn-outline me-2" asp-controller="Admin" asp-action="DonationRequests">View Donation Requests</a>
                <a class="btn theme-btn-outline me-2" asp-controller="Admin" asp-action="ViewBloodRequests">View Blood Request</a>
                <a class="btn theme-btn-outline" asp-controller="Admin" asp-action="ViewDonors">View Donors</a>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold">Low Stock Alert</h5>
                <div class="d-flex ">
                    <div class="card bg-warning text-dark me-3 mb-3 p-3" style="width:150px;">
                        <h6 class="fw-bold">A+</h6>
                        <p class="m-0">Only 3 units</p>
                    </div>
                    <div class="card bg-warning text-dark me-3 mb-3 p-3" style="width:150px;">
                        <h6 class="fw-bold">O-</h6>
                        <p class="m-0">Only 1 unit</p>
                    </div>
                    <div class="card bg-warning text-dark me-3 mb-3 p-3" style="width:150px;">
                        <h6 class="fw-bold">B+</h6>
                        <p class="m-0">Only 2 units</p>
                    </div>
                </div>
            </div>

        </div>

    </div>

</body>
</html>
