@model List<BloodDonationManagementSystem.Models.User>
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Registered Donors - MediBloodConnect</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
	<style>
				:root {
						--bg-dark: #121418;
						--surface-dark: #1a1d24;
						--surface-hover: #222630;
						--border-color: #2a2f3d;
						--accent-red: #e63946;
						--accent-amber: #f77f00;
						--accent-blue: #4cc9f0;
						--text-main: #f8f9fa;
						--text-muted: #8e95a5;

		}

				html, body {
						min-height: 100vh;
						background-color: var(--bg-dark);
						color: var(--text-main);
						font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;

		}


		/* Top Navbar */
				.navbar-custom {
						background-color: var(--surface-dark);
						border-bottom: 1px solid var(--border-color);
						padding-top: 0.5rem !important;
						padding-bottom: 0.5rem !important;

		}

				.admin-badge {
						background-color: rgba(230, 57, 70, 0.15);
						color: var(--accent-red);
						border: 1px solid rgba(230, 57, 70, 0.3);
						border-radius: 50px;
						padding: 4px 12px;
						font-size: 0.78rem;
						font-weight: 600;

		}


		/* Content Cards & Surfaces */
				.surface-card {
						background-color: var(--surface-dark);
						border: 1px solid var(--border-color);
						border-radius: 12px;

		}


		/* Form Controls */
				.form-select-dark, .form-control-dark {
						background-color: var(--bg-dark);
						border: 1px solid var(--border-color);
						color: var(--text-main);

		}

						.form-select-dark:focus, .form-control-dark:focus {
								background-color: var(--bg-dark);
								border-color: var(--accent-red);
								color: var(--text-main);
								box-shadow: 0 0 0 0.25rem rgba(230, 57, 70, 0.25);

			}


		/* Table Styling */
				.custom-table {
						color: var(--text-main);
						vertical-align: middle;
						margin-bottom: 0;

		}

					.custom-table thead th {
							background-color: rgba(255, 255, 255, 0.03);
							border-bottom: 1px solid var(--border-color);
							color: var(--text-muted);
							font-size: 0.75rem;
							text-transform: uppercase;
							letter-spacing: 0.5px;
							padding: 12px 16px;

		}

					.custom-table tbody td {
							border-bottom: 1px solid var(--border-color);
							padding: 14px 16px;
							background-color: transparent;
							color: var(--text-main);

		}

					.custom-table tbody tr:hover td {
							background-color: var(--surface-hover);

		}


		/* Section Headings */
				.section-label {
						font-size: 0.75rem;
						letter-spacing: 0.5px;

		}


	</style>
</head>

<body class="d-flex flex-column h-100">
	<!-- Top Navigation Header -->
	<header>
		<nav class="navbar navbar-expand-lg navbar-dark navbar-custom px-3">
			<div class="container-fluid px-4">
				<a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Admin" asp-action="Dashboard">
					<i class="bi bi-droplet-fill text-danger fs-5 me-2"></i>
					<span class="text-light fs-6">Medi</span>
					<span class="text-danger fs-6">Blood</span>
					<span class="text-light fs-6">Connect</span>
				</a>

				<button class="navbar-toggler py-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarContent">
					<!-- Centered Admin Navigation Links -->
					<ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-3 small">
						<li class="nav-item">
							<a class="nav-link text-light opacity-75 py-1 px-2" asp-controller="Admin" asp-action="Dashboard">Home</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-light opacity-75 py-1 px-2" asp-controller="Admin" asp-action="DonationRequests">Donations</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-light opacity-75 py-1 px-2" asp-controller="Admin" asp-action="ViewBloodRequests">Blood Requests</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-light opacity-75 py-1 px-2" asp-controller="Admin" asp-action="ViewDonors">Donors</a>
						</li>
					</ul>

					<!-- Right Side Administrator Dropdown -->
					<div class="d-flex align-items-center gap-2">
						<div class="dropdown">
							<button class="admin-badge btn border-0 d-flex align-items-center gap-2 dropdown-toggle py-1 px-3"
									type="button"
									id="adminDropdown"
									data-bs-toggle="dropdown"
									aria-expanded="false"
									style="cursor: pointer;">
								<i class="bi bi-shield-check"></i> Administrator
							</button>

							<ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow border-0 mt-2"
								aria-labelledby="adminDropdown"
								style="background-color: var(--surface-dark, #1a1d24); border: 1px solid var(--border-color, #2a2f3d) !important;">
								<li>
									<a class="dropdown-item d-flex align-items-center gap-2 text-danger small py-2 fw-semibold"
									   asp-area="Identity"
									   asp-page="/Account/Admin/Login">
										<i class="bi bi-box-arrow-right fs-6"></i> Logout
									</a>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</nav>
	</header>
	<div class="container-fluid px-4 py-4 flex-grow-1">
		<!-- Back to Dashboard Action -->
		<div class="mb-3">
			<a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-light d-inline-flex align-items-center gap-2">
				<i class="bi bi-arrow-left"></i> Back to Dashboard
			</a>
		</div>

		<!-- Centered Header Section -->
		<div class="text-center mb-4">
			<div class="d-inline-flex align-items-center justify-content-center gap-2 text-danger fw-semibold small text-uppercase mb-1" style="letter-spacing: 0.5px;">
				<i class="bi bi-heart-pulse-fill"></i> Management Portal
			</div>
			<p class="text-secondary small mb-0 mx-auto" style="max-width: 600px;">
				View and manage registered blood donors and coordinate life-saving donations.
			</p>
		</div>

		<!-- Filter Card -->
		<div class="surface-card p-4 mb-4">
			<form method="get" asp-action="ViewDonors" asp-controller="Admin" id="donorFilterForm">
				<div class="row g-3 align-items-end">
					<div class="col-md-4">
						<label class="form-label text-secondary section-label text-uppercase fw-semibold mb-2">
							<i class="bi bi-droplet me-1"></i> Blood Group
						</label>
						<select name="bloodGroup" class="form-select form-select-dark">
							<option value="">All Blood Groups</option>
							<option>A+</option>
							<option>A-</option>
							<option>B+</option>
							<option>B-</option>
							<option>O+</option>
							<option>O-</option>
							<option>AB+</option>
							<option>AB-</option>
						</select>
					</div>

					<div class="col-md-4">
						<label class="form-label text-secondary section-label text-uppercase fw-semibold mb-2">
							<i class="bi bi-check-circle me-1"></i> Availability
						</label>
						<select name="availability" class="form-select form-select-dark">
							<option value="">All Statuses</option>
							<option value="yes">Available</option>
							<option value="no">Not Available</option>
						</select>
					</div>

					<div class="col-md-4">
						<button type="submit" class="btn btn-danger w-100 fw-semibold d-flex align-items-center justify-content-center gap-2">
							<i class="bi bi-search"></i> Search Donors
						</button>
					</div>
				</div>
			</form>
		</div>

		<!-- Table Data Card -->
		<div class="surface-card overflow-hidden">
			<div class="table-responsive">
				<table class="table custom-table align-middle text-center">
					<thead>
						<tr>
							<th scope="col">#</th>
							<th scope="col">Donor Name</th>
							<th scope="col">Age</th>
							<th scope="col">Blood Group</th>
							<th scope="col">Contact</th>
							<th scope="col">Availability</th>
						</tr>
					</thead>
					<tbody id="donorsTable">
						@await Html.PartialAsync("_DonorsTable", Model)
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		$(document).ready(function () {
			$('#donorFilterForm').on('submit', function (e) {
				e.preventDefault();

				var bloodGroup = $('select[name="bloodGroup"]').val() || null;
				var availability = $('select[name="availability"]').val() || null;

				$.ajax({
					url: '@Url.Action("DonorsTable", "Admin")',
					type: 'get',
					data: { bloodGroup: bloodGroup, availability: availability },
					success: function (res) {
						$('#donorsTable').html(res);
					},
					error: function () {
						alert('Error loading donors');
					}
				});
			});
		});
	</script>
</body>
</html> 