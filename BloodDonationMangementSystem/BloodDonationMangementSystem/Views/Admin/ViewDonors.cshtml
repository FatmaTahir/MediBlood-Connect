@model List<BloodDonationManagementSystem.Models.User>
@{
    Layout = null;
}
<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
    <div class="d-flex min-vh-100">
        <div class="flex-grow-1 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-dark fw-bold">Registered Donors</h2>
                <a  asp-controller="Admin" asp-action="ViewDonors"   class="btn btn-outline-secondary">Refresh</a>
            </div>
           
            <div class="card shadow-lg mb-4">
                <div class="card-body">
                    <form method="get" asp-action="ViewDonors" asp-controller="Admin">
                        <div class="row g-3 align-items-end">

                            <div class="col-md-3">
                                <label class="form-label fw-bold">Blood Group</label>
                                <select name="bloodGroup" class="form-select">
                                    <option value="">All</option>
                                    <option>A+</option>
                                    <option>A-</option>
                                    <option>B+</option>
                                    <option>B-</option>
                                    <option>O+</option>
                                    <option>O-</option>
                                    <option>AB+</option>
                                    <option>AB-</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold">Availability</label>
                                <select name="availability" class="form-select">
                                    <option value="">All</option>
                                    <option value="yes">Available</option>
                                    <option value="no">Not Available</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <button class="btn btn-danger w-50">Search</button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Donor Name</th>
                                <th>Age</th>
                                <th>Blood Group</th>
                                <th>Contact</th>
                                <th>Availability</th>
                               
                            </tr>
                        </thead>

                        @await Html.PartialAsync("_DonorsTable", Model)
                       
                    </table>
                </div>
            </div>

        </div>
    </div>

</body>


</html>
<script>
    $(document).ready(function () {
        $('#donorFilterForm').on('submit', function (e) {
            e.preventDefault();

            var bloodGroup = $('select[name="bloodGroup"]').val() || null;
            var availability = $('select[name="availability"]').val() || null;

            $.ajax({
                url: '@Url.Action("DonorsTable", "Admin")',
                type: 'get',
                data: { bloodGroup: bloodGroup, availability: availability },
                success: function (res) {
                    $('#donorsTable').html(res);
                },
                error: function () {
                    alert('Error loading donors');
                }
            });
        });
    });
</script>
