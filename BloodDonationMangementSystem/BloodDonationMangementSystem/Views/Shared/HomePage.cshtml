@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MediBlood Connect - Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        /* Enable Smooth Scrolling */
        html {
            scroll-behavior: smooth;
        }

        /* Dark Modern Navbar */
        .navbar-custom {
            background-color: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Modern Hero & How-It-Works Background Section */
        .hero-section {
            background: linear-gradient(rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1615461066841-6116e61058f4?q=80&w=1920&auto=format&fit=crop') no-repeat center center / cover;
            color: #ffffff;
        }

        /* Glassmorphic step cards */
        .step-card {
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(12px);
            transition: all 0.3s ease-in-out;
        }

            .step-card:hover {
                transform: translateY(-8px);
                border-color: #dc3545;
                box-shadow: 0 12px 30px rgba(220, 53, 69, 0.25);
                background: rgba(255, 255, 255, 0.12);
            }

        .step-badge {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
        }

        .about-section {
            background-color: #ffffff;
            border-top: 4px solid #dc3545;
        }

        /* Footer Styling */
        footer {
            background-color: #0f172a;
            color: #cbd5e1;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

            footer a {
                color: #94a3b8;
                text-decoration: none;
                transition: color 0.2s ease-in-out;
            }

                footer a:hover {
                    color: #dc3545;
                }

        .footer-social-icon {
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            transition: all 0.3s ease;
        }

            .footer-social-icon:hover {
                background: #dc3545;
                color: #ffffff;
                transform: translateY(-3px);
            }
    </style>
</head>

<body class="bg-light">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-link navbar-brand fw-bold text-white d-flex align-items-center" href="#">
                <i class="bi bi-droplet-fill text-danger fs-4 me-2"></i>
                <span class="text-light">Medi</span>
                <span class="text-danger">Blood</span>
                <span class="text-light">Connect</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#how-it-works">How It Works</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about-us">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact-us">Contact Us</a>
                    </li>
                </ul>

                <!-- Admin Login Button in Right Corner -->
                <div class="d-flex">
                    <a class="btn btn-outline-danger btn-sm px-3 fw-semibold rounded-pill"
                       asp-area="Identity"
                       asp-page="/Account/Admin/Login">
                        <i class="bi bi-shield-lock me-1"></i> Admin Login
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- TOP SECTION (Hero + How It Works with Single Background) -->
    <div class="hero-section pb-5 pt-5">

        <!-- HERO SECTION -->
        <div class="container pt-5">
            <div class="row align-items-center pt-5 pb-3">
                <div class="col-lg-7">
                    <h1 style="font-size: 3.2rem; font-weight: 800; line-height: 1.2;">
                        Connecting Blood Donors<br />
                        With Those in Need
                    </h1>
                    <p class="fs-5 opacity-75 mt-3">
                        Whether you want to donate blood or urgently need it, we help you connect with the right people at the right time.
                    </p>
                </div>
            </div>

            <!-- CTA BUTTONS -->
            <div class="mt-2 mb-5">
                <a class="btn btn-danger btn-lg me-3 px-4 py-2 fw-semibold shadow"
                   asp-area="Identity"
                   asp-page="/Account/Login">
                    Donate Blood
                </a>
                <a class="btn btn-outline-light btn-lg px-4 py-2"
                   asp-area="Identity"
                   asp-page="/Account/Patient/Login">
                    Request Blood
                </a>
            </div>
        </div>

        <!-- HOW IT WORKS SECTION -->
        <div id="how-it-works" class="container text-center pt-5 pb-4" style="scroll-margin-top: 70px;">
            <span class="badge bg-danger bg-opacity-20 text-white border border-danger px-3 py-2 rounded-pill fw-semibold mb-2">
                Simple Steps
            </span>
            <h2 class="fw-bold mb-3 display-6 text-white">Giving &amp; Receiving Blood Made Easy</h2>

            <p class="mb-5 mx-auto text-light opacity-75" style="max-width: 700px; font-size: 1.1rem;">
                MediBlood Connect makes it simple for donors to save lives
                and for patients to find matching blood quickly.
            </p>

            <div class="row g-4 text-start">
                <!-- Step 01 -->
                <div class="col-md-4">
                    <div class="p-4 rounded-4 step-card h-100">
                        <div class="step-badge bg-danger text-white fw-bold fs-4 d-flex align-items-center justify-content-center mb-3">
                            01
                        </div>
                        <h5 class="fw-bold text-white mb-2">Register &amp; Health Check</h5>
                        <p class="text-light opacity-75 mb-0">
                            Donors create an account to donate. Patients register to request blood instantly.
                        </p>
                    </div>
                </div>

                <!-- Step 02 -->
                <div class="col-md-4">
                    <div class="p-4 rounded-4 step-card h-100">
                        <div class="step-badge bg-danger text-white fw-bold fs-4 d-flex align-items-center justify-content-center mb-3">
                            02
                        </div>
                        <h5 class="fw-bold text-white mb-2">Blood Donation</h5>
                        <p class="text-light opacity-75 mb-0">
                            Donors donate blood. Patients connect with matching donors without delays.
                        </p>
                    </div>
                </div>

                <!-- Step 03 -->
                <div class="col-md-4">
                    <div class="p-4 rounded-4 step-card h-100">
                        <div class="step-badge bg-danger text-white fw-bold fs-4 d-flex align-items-center justify-content-center mb-3">
                            03
                        </div>
                        <h5 class="fw-bold text-white mb-2">Rest &amp; Save Lives</h5>
                        <p class="text-light opacity-75 mb-0">
                            Blood saves lives while donors recover knowing they made a lasting impact.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ABOUT US SECTION -->
    <section id="about-us" class="about-section py-5 text- shadow-sm" style="scroll-margin-top: 70px;">
        <div class="container py-4">
            <div class="row justify-content-center text-center">
                <div class="col-lg-10 col-xl-9">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-3 mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-heart-pulse-fill fs-3"></i>
                    </div>
                    <h2 class="text-danger fw-bolder fs-2 mb-4">About Us</h2>

                    <p class="fs-5 text-secondary mb-4 px-md-4">
                        MediBlood Connect connects blood donors with patients in need through a fast
                        and reliable digital platform. Our goal is to make blood donation simple, efficient,
                        and accessible, helping save lives when every second matters. At MediBlood Connect, we aim to raise awareness about the importance of blood donation and create a reliable network that saves lives.
                    </p>

                    <div class="p-3 bg-light rounded-3 border-start border-danger border-4 d-inline-block text-start mt-2 shadow-sm">
                        <p class="fw-bold text-dark mb-0">
                            <i class="bi bi-check-circle-fill text-danger me-2"></i>
                            Join us in our mission to ensure no patient suffers due to a lack of blood.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER / CONTACT US SECTION -->
    <footer id="contact-us" class="pt-5 pb-4" style="scroll-margin-top: 70px;">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Brand Info -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-droplet-fill text-danger fs-3 me-2"></i>
                        <span class="fs-4 fw-bold text-white">MediBlood Connect</span>
                    </div>
                    <p class="small text-light pe-lg-4">
                        Connecting life-saving blood donors with patients in urgent need. Simple, fast, and secure digital platform built to bridge the gap in healthcare emergencies.
                    </p>
                    <div class="d-flex gap-2 pt-2">
                        <a href="#" class="footer-social-icon" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="footer-social-icon" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="footer-social-icon" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="footer-social-icon" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a href="#"><i class="bi bi-chevron-right text-danger me-1"></i> Home</a></li>
                        <li><a href="#how-it-works"><i class="bi bi-chevron-right text-danger me-1"></i> How It Works</a></li>
                        <li><a href="#about-us"><i class="bi bi-chevron-right text-danger me-1"></i> About Us</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-chevron-right text-danger me-1"></i> Donate Blood</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Patient/Login"><i class="bi bi-chevron-right text-danger me-1"></i> Request Blood</a></li>
                    </ul>
                </div>

                <!-- Contact Info -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Contact Us</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-light mb-0">
                        <li class="d-flex align-items-start">
                            <i class="bi bi-geo-alt-fill text-danger me-2 mt-1"></i>
                            <span>123 Health Ave, Suite 400, Medical District</span>
                        </li>
                        <li class="d-flex align-items-center">
                            <i class="bi bi-telephone-fill text-danger me-2"></i>
                            <span>+1 (800) 555-BLOOD</span>
                        </li>
                        <li class="d-flex align-items-center">
                            <i class="bi bi-envelope-fill text-danger me-2"></i>
                            <span>support@medibloodconnect.com</span>
                        </li>
                        <li class="d-flex align-items-center">
                            <i class="bi bi-clock-fill text-danger me-2"></i>
                            <span>24/7 Emergency Support</span>
                        </li>
                    </ul>
                </div>

                <!-- Quick Query Form -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Send Us a Message</h6>
                    <form onsubmit="event.preventDefault(); alert('Thank you! Your message has been sent.');">
                        <div class="mb-2">
                            <input type="email" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Your Email" required />
                        </div>
                        <div class="mb-2">
                            <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="2" placeholder="Your Message..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger btn-sm w-100 fw-semibold">
                            Send Message <i class="bi bi-send ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>

            <hr class="border-secondary opacity-25 my-4" />

            <!-- Bottom Copyright & Legal -->
            <div class="row align-items-center small text-light">
                <div class="col-md-6 text-center  mb-2 mb-md-0">
                    &copy; 2026 MediBlood Connect. All rights reserved.
                </div>
                
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>