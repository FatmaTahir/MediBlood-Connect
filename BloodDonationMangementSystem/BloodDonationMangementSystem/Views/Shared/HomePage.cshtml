<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        /* Modern Hero & How-It-Works Background Section */
        .hero-section {
            background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.85)), url('https://images.unsplash.com/photo-1615461066841-6116e61058f4?q=80&w=1920&auto=format&fit=crop') no-repeat center center / cover;
            color: #ffffff;
        }

        /* Glassmorphic step cards */
        .step-card {
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(12px);
            transition: all 0.3s ease-in-out;
        }

            .step-card:hover {
                transform: translateY(-8px);
                border-color: #dc3545;
                box-shadow: 0 12px 30px rgba(220, 53, 69, 0.25);
                background: rgba(255, 255, 255, 0.12);
            }

        .step-badge {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
        }

        .about-section {
            background-color: #ffffff;
            border-top: 4px solid #dc3545;
        }
    </style>
</head>

<body class="bg-light">

    <!-- TOP SECTION (Hero + How It Works with Single Dynamic BG) -->
    <div class="hero-section pb-5">

        <!-- HERO SECTION -->
        <div class="container pt-5">
            <div class="row align-items-center pt-5 pb-3">
                <div class="col-lg-7">
                    <h1 style="font-size: 3.2rem; font-weight: 800; line-height: 1.2;">
                        Connecting Blood Donors<br />
                        With Those in Need
                    </h1>
                    <p class="fs-5 opacity-75 mt-3">
                        Whether you want to donate blood or urgently need it, we help you connect with the right people at the right time.
                    </p>
                </div>
            </div>

            <!-- CTA BUTTONS -->
            <div class="mt-2 mb-5">
                <a class="btn btn-danger btn-lg me-3 px-4 py-2 fw-semibold shadow"
                   asp-area="Identity"
                   asp-page="/Account/Login">
                    Donate Blood
                </a>
                <a class="btn btn-outline-light btn-lg px-4 py-2 "
                   asp-area="Identity"
                   asp-page="/Account/Patient/Login">
                    Request Blood
                </a>
            </div>
        </div>

        <!-- HOW IT WORKS SECTION -->
        <div class="container text-center pt-4 pb-2">
            <span class="badge bg-danger bg-opacity-20 text-white border border-danger px-3 py-2 rounded-pill fw-semibold mb-2">
                Simple Steps
            </span>
            <h2 class="fw-bold mb-3 display-6 text-white">Giving &amp; Receiving Blood Made Easy</h2>

            <p class="mb-5 mx-auto text-light opacity-75" style="max-width: 700px; font-size: 1.1rem;">
                MediBlood Connect makes it simple for donors to save lives
                and for patients to find matching blood quickly.
            </p>

            <div class="row g-4 text-start">
                <!-- Step 01 -->
                <div class="col-md-4">
                    <div class="p-4 rounded-4 step-card h-100">
                        <div class="step-badge bg-danger text-white fw-bold fs-4 d-flex align-items-center justify-content-center mb-3">
                            01
                        </div>
                        <h5 class="fw-bold text-white mb-2">Register &amp; Health Check</h5>
                        <p class="text-light opacity-75 mb-0">
                            Donors create an account to donate. Patients register to request blood instantly.
                        </p>
                    </div>
                </div>

                <!-- Step 02 -->
                <div class="col-md-4">
                    <div class="p-4 rounded-4 step-card h-100">
                        <div class="step-badge bg-danger text-white fw-bold fs-4 d-flex align-items-center justify-content-center mb-3">
                            02
                        </div>
                        <h5 class="fw-bold text-white mb-2">Blood Donation</h5>
                        <p class="text-light opacity-75 mb-0">
                            Donors donate blood. Patients connect with matching donors without delays.
                        </p>
                    </div>
                </div>

                <!-- Step 03 -->
                <div class="col-md-4">
                    <div class="p-4 rounded-4 step-card h-100">
                        <div class="step-badge bg-danger text-white fw-bold fs-4 d-flex align-items-center justify-content-center mb-3">
                            03
                        </div>
                        <h5 class="fw-bold text-white mb-2">Rest &amp; Save Lives</h5>
                        <p class="text-light opacity-75 mb-0">
                            Blood saves lives while donors recover knowing they made a lasting impact.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ABOUT US SECTION -->
    <section class="about-section py-5 text-dark shadow-sm">
        <div class="container py-4">
            <div class="row justify-content-center text-center">
                <div class="col-lg-10 col-xl-9">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-3 mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-heart-pulse-fill fs-3"></i>
                    </div>
                    <h2 class="text-danger fw-bolder fs-2 mb-4">About Us</h2>

                    <p class="fs-5 text-secondary mb-4 px-md-4">
                        MediBlood Connect connects blood donors with patients in need through a fast
                        and reliable digital platform. Our goal is to make blood donation simple, efficient,
                        and accessible, helping save lives when every second matters. At MediBlood Connect, we aim to raise awareness about the importance of blood donation and create a reliable network that saves lives.
                    </p>

                    <div class="p-3 bg-light rounded-3 border-start border-danger border-4 d-inline-block text-start mt-2 shadow-sm">
                        <p class="fw-bold text-dark mb-0">
                            <i class="bi bi-check-circle-fill text-danger me-2"></i>
                            Join us in our mission to ensure no patient suffers due to a lack of blood.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

</body>
</html>