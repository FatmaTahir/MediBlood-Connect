<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BloodDonationMangementSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BloodDonationMangementSystem.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 bg-light">

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark box-shadow mb-0 py-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-2"></i>
                    <span><span class="text-light">Medi</span><span class="text-danger">Blood</span><span class="text-light">Connect</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item px-2">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item px-2">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item px-2">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="HowItWorks">How It Works</a>
                        </li>
                        <li class="nav-item px-2">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Contact">Contact Us</a>
                        </li>
                    </ul>

                    <a class="btn btn-outline-danger text-light px-3" asp-area="Identity" asp-page="/Account/Admin/Login">
                        Admin Login
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Container -->
    <main role="main" class="flex-shrink-0">
        @RenderBody()
    </main>

    <!-- Sticky Footer -->
    <footer class="bg-dark text-light pt-5 pb-3 mt-auto w-100 border-top border-secondary">
        <div class="container px-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <h4 class="fw-bold">
                        <i class="bi bi-droplet-fill text-danger me-2"></i>Medi<span class="text-danger">Blood</span>Connect
                    </h4>
                    <p class="text-light mt-3">
                        MediBlood Connect connects blood donors with patients quickly and reliably, helping save lives when every second matters.
                    </p>
                </div>

                <div class="col-md-2">
                    <h5 class="fw-bold mb-3 text-danger">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Index" class="text-light text-decoration-none">Home</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="About" class="text-light text-decoration-none">About</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="HowItWorks" class="text-light text-decoration-none">How It Works</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Contact" class="text-light text-decoration-none">Contact Us</a></li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h5 class="fw-bold mb-3 text-danger">Services</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-area="Identity" asp-page="/Account/Login" class="text-light text-decoration-none">Donate Blood</a></li>
                        <li class="mb-2"><a asp-area="Identity" asp-page="/Account/Patient/Login" class="text-light text-decoration-none">Request Blood</a></li>
                        <li class="mb-2"><a asp-area="Identity" asp-page="/Account/Admin/Login" class="text-light text-decoration-none">Admin Login</a></li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h5 class="fw-bold mb-3 text-danger">Contact</h5>
                    <ul class="list-unstyled text-light">
                        <li class="mb-2"><i class="bi bi-geo-alt-fill text-danger me-2"></i> Punjab, Pakistan</li>
                        <li class="mb-2"><i class="bi bi-telephone-fill text-danger me-2"></i> +92 300 1234567</li>
                        <li class="mb-2"><i class="bi bi-envelope-fill text-danger me-2"></i> support@mbconnect.com</li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-4">

            <div class="text-center text-light">
                &copy; 2026 MediBloodConnect. All Rights Reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>