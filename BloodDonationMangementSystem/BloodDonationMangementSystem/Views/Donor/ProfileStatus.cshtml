@model IEnumerable<BloodDonationManagementSystem.Models.DonationRequest>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile Status - MediBloodConnect</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #121417;
            --card-dark: #1e2228;
            --card-border: rgba(255, 255, 255, 0.08);
            --primary-red: #e63946;
            --primary-red-hover: #c92a37;
            --accent-glow: rgba(230, 57, 70, 0.25);
            --text-muted: #9fa6ad;
        }

        html, body {
            height: 100vh;
            margin: 0;
            overflow: hidden;
            background-color: var(--bg-dark);
            color: #f8f9fa;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .page-wrapper {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        .navbar-custom {
            background-color: #16191d;
            border-bottom: 1px solid var(--card-border);
            height: 52px;
            flex-shrink: 0;
        }

        .brand-logo {
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: -0.5px;
            color: #fff;
            text-decoration: none;
        }

        /* Top-center alignment */
        .main-content {
            flex: 1;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 3rem 1.5rem 1.5rem 1.5rem;
            overflow-y: auto;
        }

        /* Wider rectangular card shape */
        .glass-card {
            background-color: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(8px);
            width: 100%;
            max-width: 900px;
        }

        .table-custom {
            --bs-table-bg: transparent;
            --bs-table-color: #f8f9fa;
            --bs-table-border-color: rgba(255, 255, 255, 0.06);
            margin-bottom: 0;
        }

            .table-custom th {
                color: #fff;
                font-weight: 600;
                font-size: 0.875rem;
                border-bottom: 1px solid var(--card-border);
                padding-bottom: 0.75rem;
            }

            .table-custom td {
                padding: 0.85rem 0.5rem;
                font-size: 0.875rem;
            }

        .badge-status {
            font-weight: 600;
            padding: 0.35em 0.75em;
            font-size: 0.75rem;
            border-radius: 6px;
        }

        .badge-pending {
            background-color: #ffc107;
            color: #000;
        }

        .badge-approved {
            background-color: #198754;
            color: #fff;
        }

        .badge-rejected {
            background-color: #dc3545;
            color: #fff;
        }

        .btn-outline-custom {
            background: transparent;
            border: 1px solid var(--card-border);
            color: #e2e8f0;
            font-weight: 600;
            font-size: 0.85rem;
            border-radius: 6px;
            padding: 0.45rem 1.15rem;
            transition: all 0.2s;
            text-decoration: none;
        }

            .btn-outline-custom:hover {
                background-color: rgba(255, 255, 255, 0.05);
                color: #fff;
                border-color: rgba(255, 255, 255, 0.2);
            }
    </style>
</head>
<body>

    <div class="page-wrapper">
        <!-- Header / Navbar -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark navbar-custom px-3">
                <div class="container-fluid">
                    <a class="brand-logo d-flex align-items-center gap-2" asp-controller="Donor" asp-action="DonorDashboard">
                        <i class="bi bi-droplet-fill text-danger fs-5"></i>
                        <span>Medi<span class="text-danger">Blood</span>Connect</span>
                    </a>

                    <button class="navbar-toggler py-0 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarContent">
                        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-3 small">
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="DonorDashboard">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="ProfileStatus">My Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="RequestDonation">Request Donation</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="EditProfile">Edit Profile</a>
                            </li>
                        </ul>

                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-danger btn-sm px-2 py-1 fs-7" asp-area="Identity"
                               asp-page="/Account/Login">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Main Content (Top-Centered Glass Card) -->
        <main class="main-content">
            <div class="glass-card p-4">

                <!-- Page Title Header -->
                <div class="text-center mb-4">
                    <div class="d-flex align-items-center justify-content-center gap-1 text-danger fw-semibold fs-7 mb-1">
                        <i class="bi bi-heart-pulse-fill"></i> DONOR PORTAL
                    </div>
                    <p class="text-secondary small mb-0">Here is the current status of your submitted donation requests.</p>
                </div>

                @if (Model == null || !Model.Any())
                {
                    <div class="alert alert-dark border border-secondary text-secondary text-center small my-4 py-3">
                        <i class="bi bi-info-circle me-1"></i> You have not submitted any donation requests yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive mb-4">
                        <table class="table table-custom align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 20%;">Date</th>
                                    <th style="width: 65%;">Reason</th>
                                    <th style="width: 15%;" class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model)
                                {
                                    <tr>
                                        <td class="text-light">
                                            @(request.RequestDate != default ? request.RequestDate.ToString("MMM dd, yyyy") : "N/A")
                                        </td>
                                        <td class="text-secondary">
                                            @request.Reason
                                        </td>
                                        <td class="text-end">
                                            @if (string.Equals(request.Status, "approved", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge badge-status badge-approved">Approved</span>
                                            }
                                            else if (string.Equals(request.Status, "rejected", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge badge-status badge-rejected">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-status badge-pending">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="d-flex align-items-center justify-content-start pt-1">
                    <a asp-controller="Donor" asp-action="DonorDashboard" class="btn btn-outline-custom">
                        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                    </a>
                </div>

            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>