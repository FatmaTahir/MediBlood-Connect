@model BloodDonationManagementSystem.Models.User
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Donor Dashboard - MediBloodConnect</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #121417;
            --card-dark: #1e2228;
            --card-border: rgba(255, 255, 255, 0.08);
            --primary-red: #e63946;
            --primary-red-hover: #c92a37;
            --accent-glow: rgba(230, 57, 70, 0.25);
            --text-muted: #9fa6ad;
        }

        body {
            background-color: var(--bg-dark);
            color: #f8f9fa;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Top Navbar */
        .navbar-custom {
            background-color: #16191d;
            border-bottom: 1px solid var(--card-border);
            height: 60px;
        }

        .brand-logo {
            font-weight: 700;
            font-size: 1.25rem;
            letter-spacing: -0.5px;
            color: #fff;
            text-decoration: none;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background-color: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(8px);
        }

        /* Dark Modern Profile Table */
        .profile-table {
            --bs-table-bg: transparent;
            --bs-table-color: #e2e8f0;
            color: #e2e8f0;
            margin-bottom: 0;
            font-size: 0.875rem;
        }

            .profile-table th {
                background-color: rgba(255, 255, 255, 0.03) !important;
                color: var(--text-muted) !important;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.7rem;
                letter-spacing: 0.8px;
                border-bottom: 1px solid var(--card-border) !important;
                padding: 0.6rem 1rem;
            }

            .profile-table tbody tr,
            .profile-table td {
                background-color: transparent !important;
                color: #e2e8f0 !important;
                border-bottom: none !important;
                padding: 0.65rem 1rem;
                vertical-align: middle;
            }

        /* Custom Badges */
        .badge-blood {
            background-color: var(--accent-glow);
            color: #ff6b6b;
            border: 1px solid rgba(230, 57, 70, 0.3);
            font-weight: 700;
            padding: 0.25em 0.6em;
            font-size: 0.75rem;
            border-radius: 6px;
        }

        .badge-available {
            background-color: rgba(40, 167, 69, 0.15);
            color: #2ecc71;
            border: 1px solid rgba(40, 167, 69, 0.3);
            font-size: 0.75rem;
        }

        .badge-unavailable {
            background-color: rgba(220, 53, 69, 0.15);
            color: #ff6b6b;
            border: 1px solid rgba(220, 53, 69, 0.3);
            font-size: 0.75rem;
        }

        /* Compact Action Icon Containers */
        .action-icon {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .btn-red-accent {
            background-color: var(--primary-red);
            color: #fff;
            border: none;
            font-weight: 600;
            font-size: 0.8rem;
            border-radius: 6px;
            transition: all 0.2s;
        }

            .btn-red-accent:hover {
                background-color: var(--primary-red-hover);
                color: #fff;
                box-shadow: 0 3px 8px var(--accent-glow);
            }

        .btn-outline-custom {
            background: transparent;
            border: 1px solid var(--card-border);
            color: #e2e8f0;
            font-weight: 600;
            font-size: 0.8rem;
            border-radius: 6px;
            transition: all 0.2s;
        }

            .btn-outline-custom:hover {
                background-color: rgba(255, 255, 255, 0.05);
                color: #fff;
                border-color: rgba(255, 255, 255, 0.2);
            }
    </style>
</head>
<body>

    <!-- Header / Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom px-3">
            <div class="container-fluid">
                <a class="brand-logo d-flex align-items-center gap-2" asp-controller="Donor" asp-action="DonorDashboard">
                    <i class="bi bi-droplet-fill text-danger fs-5"></i>
                    <span>Medi<span class="text-danger">Blood</span>Connect</span>
                </a>

                <button class="navbar-toggler py-0 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-3 small">
                        <li class="nav-item">
                            <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="DonorDashboard">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="ProfileStatus">My Requests</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="RequestDonation">Request Donation</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="EditProfile">Edit Profile</a>
                        </li>
                    </ul>

                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-danger btn-sm px-2 py-1 fs-7" asp-area="Identity"
                           asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <!-- Main Content Container -->
    <div class="container py-3">

        <!-- Centered Header Section -->
        <div class="text-center mb-3">
            <div class="d-flex align-items-center justify-content-center gap-2 text-danger fw-semibold small mb-1">
                <i class="bi bi-heart-pulse-fill"></i> DONOR PORTAL
            </div>
            @* <h3 class="fw-bold mb-0">Welcome back, @Model.FullName</h3> *@
            <p class="text-secondary small mb-0">Manage your donation details, availability status, and account settings.</p>
        </div>

        <!-- Profile Information Summary -->
        <div class="glass-card mb-3 overflow-hidden">
            <div class="px-3 py-2 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-light"><i class="bi bi-person-vcard me-2 text-danger"></i>Donor Overview</h6>
                <span class="badge badge-blood">
                    <i class="bi bi-droplet-half me-1"></i> Blood Group: @Model.BloodGroup
                </span>
            </div>
            <div class="table-responsive">
                <table class="table profile-table align-middle">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Age</th>
                            <th>Contact</th>
                            <th>CNIC</th>
                            <th>Availability Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-semibold">@Model.FullName</td>
                            <td>@Model.Age yrs</td>
                            <td>@Model.Contact</td>
                            <td>@Model.CNIC</td>
                            <td>
                                @if (Model.Availability)
                                {
                                    <span class="badge badge-available px-2 py-1 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i> Available to Donate
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-unavailable px-2 py-1 rounded-pill">
                                        <i class="bi bi-x-circle-fill me-1"></i> Currently Unavailable
                                    </span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Horizontal Quick Action Command Strip -->
        <div class="glass-card p-3">
            <div class="row g-3 align-items-center">

                <!-- Action 1: Request Donation -->
                <div class="col-md-4 border-end-md border-secondary border-opacity-20">
                    <div class="d-flex align-items-center justify-content-between pe-md-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="action-icon text-danger bg-danger bg-opacity-10 border border-danger border-opacity-25">
                                <i class="bi bi-droplet-fill fs-6"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-light small">Request Donation</h6>
                                <span class="text-secondary opacity-75" style="font-size: 0.75rem;">Start new donation process</span>
                            </div>
                        </div>
                        <a asp-controller="Donor" asp-action="RequestDonation" class="btn btn-red-accent btn-sm px-2.5 py-1">
                            Start <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </div>
                </div>

                <!-- Action 2: View Status -->
                <div class="col-md-4 border-end-md border-secondary border-opacity-20">
                    <div class="d-flex align-items-center justify-content-between px-md-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="action-icon text-info bg-info bg-opacity-10 border border-info border-opacity-25">
                                <i class="bi bi-clock-history fs-6"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-light small">Request Status</h6>
                                <span class="text-secondary opacity-75" style="font-size: 0.75rem;">Track pending & past requests</span>
                            </div>
                        </div>
                        <a asp-controller="Donor" asp-action="ProfileStatus" class="btn btn-outline-custom btn-sm px-2.5 py-1">
                            View <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </div>
                </div>

                <!-- Action 3: Edit Profile -->
                <div class="col-md-4">
                    <div class="glass-action-item d-flex align-items-center justify-content-between ps-md-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="action-icon text-secondary bg-secondary bg-opacity-10 border border-secondary border-opacity-25">
                                <i class="bi bi-gear-fill fs-6"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-light small">Edit Profile</h6>
                                <span class="text-secondary opacity-75" style="font-size: 0.75rem;">Update contact & availability</span>
                            </div>
                        </div>
                        <a asp-controller="Donor" asp-action="EditProfile" class="btn btn-outline-custom btn-sm px-2.5 py-1">
                            Edit <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- SignalR Notification Script -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.7/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("ReceiveNotification", function(message) {
            alert(message);
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>