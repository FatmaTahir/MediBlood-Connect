@model BloodDonationManagementSystem.Models.User
@{
    Layout = null;
}
<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #f5f6f7;
            font-family: 'Segoe UI', sans-serif;
        }

        .dashboard-title {
            color: black;
        }

        .dashboard-subtitle {
            color: #6c757d;
        }

        .theme-card {
            border: none;
            border-radius: 12px;
            color: #fff;
        }

        .bg-blood {
            background: linear-gradient(135deg, #b11226, #e63946);
        }

        .bg-dark-red {
            background: linear-gradient(135deg, #7a0c1a, #b11226);
        }

        .bg-muted-dark {
            background: linear-gradient(135deg, #343a40, #495057);
        }

        .theme-btn-primary {
            background-color: #b11226;
            border: none;
        }

            .theme-btn-primary:hover {
                background-color: #8f0f1f;
            }

        .theme-btn-outline {
            border: 1px solid #b11226;
            color: #b11226;
        }

            .theme-btn-outline:hover {
                background-color: #b11226;
                color: #fff;
            }

        .low-stock-card {
            background-color: #fff3cd;
            border-left: 5px solid #b11226;
            border-radius: 8px;
        }
    </style>

</head>
<body class="m-0 p-0 bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-outline-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
    <div class="d-flex m-0 p-0">
        <div class="flex-grow-1 p-4 mt-0" >
            <div class="flex-grow-1 p-0 mt-0">
                <h2 class="fw-bold mb-4 text-dark">Donor Dashboard</h2>
                <p class="text-secondary">From here you can view your profile, update your information, and manage your blood donation requests.</p>
            </div>

            <div class="card shadow-lg">
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Full Name</th>
                                <th>Age</th>
                                <th>Contact</th>
                                <th>Blood Group</th>
                                <th>CNIC</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@Model.FullName</td>
                                <td>@Model.Age</td>
                                <td>@Model.Contact</td>
                                <td>@Model.BloodGroup</td>
                                <td>@Model.CNIC</td>
                                <td>
                                    @if (Model.Availability)
                                    {
                                        <span class="badge bg-secondary">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark-red">Not Available</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="">
                <div class="row mt-4">

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-blood shadow-lg rounded-3">
                            <div class="card-body text-center py-4">
                                <h4 class="card-title fw-bold mb-3">Request Donation</h4>
                                <a asp-controller="Donor" asp-action="RequestDonation"  class="btn btn-light px-4">Click Here</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-dark-red shadow-lg rounded-3">
                            <div class="card-body text-center py-4">
                                <h4 class="card-title fw-bold mb-3">View Request Status</h4>
                                <a asp-controller="Donor" asp-action="ProfileStatus" class="btn btn-light px-4">Click Here</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-muted-dark shadow-lg rounded-3">
                            <div class="card-body text-center py-4">
                                <h4 class="card-title fw-bold mb-3">Edit Profile</h4>
                                <a asp-controller="Donor" asp-action="EditProfile"  class="btn btn-light px-4">Click Here</a>
                            </div>
                        </div>
                    </div>

                </div>

        </div>
    </div>
    </div>
</body>
</html>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.7/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationHub")
        .build();

    connection.on("ReceiveNotification", function(message) {
        alert(message);
    });

    connection.start().catch(err => console.error(err.toString()));
</script>
