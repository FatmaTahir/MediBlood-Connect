@model BloodDonationManagementSystem.Models.User
@{
    Layout = null;
}
<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-outline-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
    <div class="d-flex m-0 p-0">
      
        <div class="flex-grow-1 p-4">

            <div class="d-flex flex-column align-items-center">

                <h2 class="fw-bold text-danger mb-2">Request to Donate Blood</h2>
                <p class="text-secondary mb-4">Fill out the form below to request a blood donation. </p>

                <div class="card shadow-lg w-75 p-4">
                    <form asp-action="RequestDonation" asp-controller="Donor" method="post">

                        <div class="">
   
                            <input type="text" name="FullName" class="form-control" value="@Model.FullName" hidden />
                        </div>

                        <div class="">
                           
                            <input name="BloodGroup" class="form-select"  value="@Model.BloodGroup"  hidden/>
                                
    
                        </div>

                        <div class="mb-3">
                            <label for="Reason" class="form-label fw-bold">Reason for Donation:</label>
                            <textarea name="Reason" class="form-control" rows="3" placeholder="Why you want to donate" required></textarea>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-danger w-25 ">Submit Request</button>
                        </div>

                    </form>
                </div>

            </div>

        </div>

    </div>

</body>
</html>
