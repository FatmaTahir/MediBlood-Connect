@model BloodDonationManagementSystem.Models.DonationRequest

@{

    Layout = null;

}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Request Donation - MediBloodConnect</title>



    <!-- Bootstrap 5 CSS & Icons -->

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">



    <style>

        :root {
            --bg-dark: #121417;
            --card-dark: #1e2228;
            --card-border: rgba(255, 255, 255, 0.08);
            --primary-red: #e63946;
            --primary-red-hover: #c92a37;
            --accent-glow: rgba(230, 57, 70, 0.25);
            --text-muted: #9fa6ad;
            --input-bg: rgba(255, 255, 255, 0.04);
        }



        html, body {
            height: 100vh;
            margin: 0;
            overflow: hidden;
            background-color: var(--bg-dark);
            color: #f8f9fa;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }



        .page-wrapper {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }



        .navbar-custom {
            background-color: #16191d;
            border-bottom: 1px solid var(--card-border);
            height: 64px;
            flex-shrink: 0;
        }



        .brand-logo {
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: -0.5px;
            color: #fff;
            text-decoration: none;
        }



        .main-content {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }



        .glass-card {
            background-color: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(8px);
            width: 100%;
            max-width: 600px;
        }



        .form-control-custom {
            background-color: var(--input-bg);
            border: 1px solid var(--card-border);
            color: #f8f9fa;
            border-radius: 8px;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            transition: all 0.2s ease-in-out;
            resize: none;
        }



            .form-control-custom:focus {
                background-color: rgba(255, 255, 255, 0.07);
                border-color: var(--primary-red);
                box-shadow: 0 0 0 0.2rem var(--accent-glow);
                color: #fff;
            }



            .form-control-custom::placeholder {
                color: var(--text-muted);
                opacity: 0.7;
            }



        .badge-blood {
            background-color: var(--accent-glow);
            color: #ff6b6b;
            border: 1px solid rgba(230, 57, 70, 0.3);
            font-weight: 600;
            padding: 0.25em 0.6em;
            font-size: 0.75rem;
            border-radius: 6px;
        }



        .btn-red-accent {
            background-color: var(--primary-red);
            color: #fff;
            border: none;
            font-weight: 600;
            font-size: 0.85rem;
            border-radius: 6px;
            padding: 0.45rem 1.15rem;
            transition: all 0.2s;
        }



            .btn-red-accent:hover {
                background-color: var(--primary-red-hover);
                color: #fff;
                box-shadow: 0 3px 10px var(--accent-glow);
            }



        .btn-outline-custom {
            background: transparent;
            border: 1px solid var(--card-border);
            color: #e2e8f0;
            font-weight: 600;
            font-size: 0.85rem;
            border-radius: 6px;
            padding: 0.45rem 1.15rem;
            transition: all 0.2s;
            text-decoration: none;
        }



            .btn-outline-custom:hover {
                background-color: rgba(255, 255, 255, 0.05);
                color: #fff;
                border-color: rgba(255, 255, 255, 0.2);
            }

    </style>

</head>

<body>



    <div class="page-wrapper">

        <!-- Header / Navbar -->

        <header>
            <nav class="navbar navbar-expand-lg navbar-dark navbar-custom px-3">
                <div class="container-fluid">
                    <a class="brand-logo d-flex align-items-center gap-2" asp-controller="Donor" asp-action="DonorDashboard">
                        <i class="bi bi-droplet-fill text-danger fs-5"></i>
                        <span>Medi<span class="text-danger">Blood</span>Connect</span>
                    </a>

                    <button class="navbar-toggler py-0 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarContent">
                        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-3 small">
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="DonorDashboard">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="ProfileStatus">My Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="RequestDonation">Request Donation</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="EditProfile">Edit Profile</a>
                            </li>
                        </ul>

                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-danger btn-sm px-2 py-1 fs-7" asp-area="Identity"
                               asp-page="/Account/Login">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>



        <!-- Main Content -->

        <main class="main-content">

            <div class="glass-card p-3 p-md-4">



                <!-- Page Title Header -->

                <div class="text-center mb-3">

                    <div class="d-flex align-items-center justify-content-center gap-1 text-danger fw-semibold fs-7 mb-1">

                        <i class="bi bi-heart-pulse-fill"></i> DONOR PORTAL

                    </div>

                    <p class="text-secondary small mb-0">Fill out the form below to initiate a blood donation request.</p>

                </div>



                <!-- Info Summary Header -->

                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom border-secondary border-opacity-20">

                    <div>

                        <span class="text-secondary fs-7 d-block">Donor Name</span>

                        <span class="fw-bold text-light small">@Model?.FullName</span>

                    </div>

                    <div class="text-end">

                        <span class="badge badge-blood">

                            <i class="bi bi-droplet-half me-1"></i> Blood Group: @Model?.BloodGroup

                        </span>

                    </div>

                </div>



                <form asp-action="RequestDonation" asp-controller="Donor" method="post">

                    <!-- Hidden Inputs for Form Submission -->

                    <input type="hidden" asp-for="FullName" />

                    <input type="hidden" asp-for="BloodGroup" />



                    <div class="mb-3">

                        <label asp-for="Reason" class="form-label text-light fw-medium small mb-1">

                            <i class="bi bi-pencil-square me-1 text-danger"></i> Reason for Donation

                        </label>

                        <textarea asp-for="Reason"
                                  class="form-control form-control-custom"
                                  rows="3"
                                  placeholder="Please explain why you want to donate or provide any relevant notes..."
                                  required></textarea>

                        <span asp-validation-for="Reason" class="text-danger small"></span>

                    </div>



                    <!-- Action Buttons -->

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-1">

                        <a asp-controller="Donor" asp-action="DonorDashboard" class="btn btn-outline-custom">

                            Cancel

                        </a>

                        <button type="submit" class="btn btn-red-accent d-inline-flex align-items-center gap-2">

                            <i class="bi bi-send-fill fs-7"></i> Submit Request

                        </button>

                    </div>

                </form>



            </div>

        </main>

    </div>



    <!-- SignalR Notification Script -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.7/signalr.min.js"></script>

    <script>

        const connection = new signalR.HubConnectionBuilder()

            .withUrl("/notificationHub")

            .build();



        connection.on("ReceiveNotification", function(message) {

            alert(message);

        });



        connection.start().catch(err => console.error(err.toString()));

    </script>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>