@model BloodDonationManagementSystem.Models.User
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Profile - MediBloodConnect</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #121417;
            --card-dark: #1e2228;
            --card-border: rgba(255, 255, 255, 0.08);
            --primary-red: #e63946;
            --primary-red-hover: #c92a37;
            --accent-glow: rgba(230, 57, 70, 0.25);
            --text-muted: #9fa6ad;
            --input-bg: rgba(255, 255, 255, 0.04);
        }

        html, body {
            height: 100vh;
            margin: 0;
            overflow: hidden; /* Prevents vertical page scrolling */
            background-color: var(--bg-dark);
            color: #f8f9fa;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .page-wrapper {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        /* Compact Top Navbar */
        .navbar-custom {
            background-color: #16191d;
            border-bottom: 1px solid var(--card-border);
            height: 64px;
            flex-shrink: 0;
        }

        .brand-logo {
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: -0.5px;
            color: #fff;
            text-decoration: none;
        }

        .main-content {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        /* Glassmorphism Card */
        .glass-card {
            background-color: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(8px);
            width: 100%;
            max-width: 620px;
        }

        /* Custom Form Controls & Selects */
        .form-control-custom, .form-select-custom {
            background-color: var(--input-bg);
            border: 1px solid var(--card-border);
            color: #f8f9fa;
            border-radius: 8px;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            transition: all 0.2s ease-in-out;
        }

            .form-select-custom option {
                background-color: var(--card-dark);
                color: #f8f9fa;
            }

            .form-control-custom:focus, .form-select-custom:focus {
                background-color: rgba(255, 255, 255, 0.07);
                border-color: var(--primary-red);
                box-shadow: 0 0 0 0.2rem var(--accent-glow);
                color: #fff;
            }

            .form-control-custom::placeholder {
                color: var(--text-muted);
                opacity: 0.7;
            }

        /* Custom Badges & Buttons */
        .badge-blood {
            background-color: var(--accent-glow);
            color: #ff6b6b;
            border: 1px solid rgba(230, 57, 70, 0.3);
            font-weight: 600;
            padding: 0.25em 0.6em;
            font-size: 0.75rem;
            border-radius: 6px;
        }

        .btn-red-accent {
            background-color: var(--primary-red);
            color: #fff;
            border: none;
            font-weight: 600;
            font-size: 0.85rem;
            border-radius: 6px;
            padding: 0.45rem 1.15rem;
            transition: all 0.2s;
        }

            .btn-red-accent:hover {
                background-color: var(--primary-red-hover);
                color: #fff;
                box-shadow: 0 3px 10px var(--accent-glow);
            }

        .btn-outline-custom {
            background: transparent;
            border: 1px solid var(--card-border);
            color: #e2e8f0;
            font-weight: 600;
            font-size: 0.85rem;
            border-radius: 6px;
            padding: 0.45rem 1.15rem;
            transition: all 0.2s;
            text-decoration: none;
        }

            .btn-outline-custom:hover {
                background-color: rgba(255, 255, 255, 0.05);
                color: #fff;
                border-color: rgba(255, 255, 255, 0.2);
            }

        .fs-7 {
            font-size: 0.75rem;
        }
    </style>
</head>
<body>

    <div class="page-wrapper">
        <!-- Header / Navbar -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark navbar-custom px-3">
                <div class="container-fluid">
                    <a class="brand-logo d-flex align-items-center gap-2" asp-controller="Donor" asp-action="DonorDashboard">
                        <i class="bi bi-droplet-fill text-danger fs-5"></i>
                        <span>Medi<span class="text-danger">Blood</span>Connect</span>
                    </a>

                    <button class="navbar-toggler py-0 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarContent">
                        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-3 small">
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="DonorDashboard">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="ProfileStatus">My Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="RequestDonation">Request Donation</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light py-0" asp-controller="Donor" asp-action="EditProfile">Edit Profile</a>
                            </li>
                        </ul>

                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-danger btn-sm px-2 py-1 fs-7" asp-area="Identity"
                               asp-page="/Account/Login">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <!-- Main Content Area -->
        <main class="main-content">
            <div class="glass-card p-3 p-md-4">

                <!-- Page Title Header -->
                <div class="text-center mb-3">
                    <div class="d-flex align-items-center justify-content-center gap-1 text-danger fw-semibold fs-7 mb-1">
                        <i class="bi bi-person-gear"></i> ACCOUNT SETTINGS
                    </div>
                    @* <h4 class="fw-bold mb-1">Edit Profile</h4> *@
                    <p class="text-secondary small mb-0">Update your account details below. All fields are required.</p>
                </div>

                <!-- Info Summary Strip -->
                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom border-secondary border-opacity-20">
                    <div>
                        <span class="text-secondary fs-7 d-block">CNIC Number</span>
                        <span class="fw-semibold text-light small">@Model.CNIC</span>
                    </div>
                    <div class="text-end">
                        <span class="badge badge-blood">
                            <i class="bi bi-droplet-half me-1"></i> Blood Group: @Model.BloodGroup
                        </span>
                    </div>
                </div>

                <form asp-controller="Donor" asp-action="EditProfile" method="post">
                    <!-- Hidden Fields -->
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="BloodGroup" value="@Model.BloodGroup" />
                    <input type="hidden" name="CNIC" value="@Model.CNIC" />

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label text-light fw-medium small mb-1">
                                <i class="bi bi-person me-1 text-danger"></i> Full Name
                            </label>
                            <input type="text" name="FullName" class="form-control form-control-custom" placeholder="Enter your full name" value="@Model.FullName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-light fw-medium small mb-1">
                                <i class="bi bi-calendar3 me-1 text-danger"></i> Age
                            </label>
                            <input type="number" name="Age" class="form-control form-control-custom" placeholder="Enter your age" value="@Model.Age" min="18" max="65" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-light fw-medium small mb-1">
                                <i class="bi bi-telephone me-1 text-danger"></i> Contact Number
                            </label>
                            <input type="tel" name="Contact" class="form-control form-control-custom" placeholder="03XXXXXXXXX" value="@Model.Contact" pattern="\d{11}" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-light fw-medium small mb-1">
                                <i class="bi bi-check2-circle me-1 text-danger"></i> Availability
                            </label>
                            <select id="availability" name="Availability" class="form-select form-select-custom">
                                <option value="true" selected="@(Model.Availability ? "selected" : null)">Available</option>
                                <option value="false" selected="@(!Model.Availability ? "selected" : null)">Not Available</option>
                            </select>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center justify-content-end gap-2 pt-1">
                        <a asp-controller="Donor" asp-action="DonorDashboard" class="btn btn-outline-custom">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-red-accent d-inline-flex align-items-center gap-2">
                            <i class="bi bi-check-lg fs-7"></i> Update Profile
                        </button>
                    </div>

                </form>

            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>