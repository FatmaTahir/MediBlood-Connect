@model BloodDonationManagementSystem.Models.User
@{
    Layout = null;
}
<html>
<head>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark  box-shadow mb-1" style="height:75px;">
            <div class="container-fluid">
                <div class="navbar-brand fw-bold">
                    <i class="bi bi-droplet-fill text-danger fs-3 me-5">
                        <span class="text-light ">Medi</span><span class="text-danger fs-3">Blood</span><span class="text-light fs-3">Connect</span>

                    </i>

                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light  me-5   ms-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light me-5 " asp-area="" asp-controller="Home" asp-action="">Contact Us</a>
                        </li>

                    </ul>
                </div>
                <a class="btn btn-outline-danger  me-5" asp-area="Identity"
                   asp-page="/Account/Admin/Login">
                    Admin Login
                </a>

            </div>
        </nav>
    </header>
    <div class="d-flex m-0 p-0">

        <div class="flex-grow-1 p-4 d-flex justify-content-center">

            <div class="card shadow-lg w-50 p-4">

                <h2 class="text-center text-danger fw-bold mb-3">Edit Profile</h2>
                <p class="text-secondary text-center mb-4">Update your profile information here. All fields are required.</p>

                <form asp-controller="Donor" asp-action="EditProfile" method="post">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="BloodGroup" value="@Model.BloodGroup" />
                    <input type="hidden" name="CNIC" value="@Model.CNIC" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Full Name</label>
                            <input type="text" name="FullName" class="form-control text-muted" placeholder="Enter your full name" value="@Model.FullName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Age</label>
                            <input type="text" name="Age" class="form-control text-muted" placeholder="Enter your age" value="@Model.Age" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Contact Number</label>
                            <input type="text" name="Contact" class="form-control text-muted" placeholder="Enter contact number" value="@Model.Contact" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Availability</label>
                            <select id="availability" name="availability" class="form-select text-muted">
                                <option value="true" selected="@(Model.Availability ? "selected" : "")">Yes</option>
                                <option value="false" selected="@(!Model.Availability ? "selected" : "")">No</option>
                            </select>
                        </div>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-danger w-25">Update </button>
                    </div>

                </form>

            </div>

        </div>

    </div>

</body>
</html>
